{
  "title": "Primary DC + DR + AWS — Native S3 (1st) + AGP Cool (2nd)",
  "unity": true,
  "sites": [
    {
      "id": "primary",
      "name": "Primary DC",
      "workloads": ["VMware", "VMs", "File Servers", "Kubernetes"],
      "vm_count": 120,
      "storage_tb": 150,
      "backup_software": "commvault",
      "backup_target": "netapp",
      "media_agents": 2,
      "retention_days": 30
    },
    {
      "id": "dr",
      "name": "DR Site",
      "workloads": ["VMware", "VMs", "File Servers", "Kubernetes"],
      "vm_count": 120,
      "storage_tb": 150,
      "backup_software": "commvault",
      "backup_target": "netapp",
      "media_agents": 2,
      "retention_days": 30
    },
    {
      "id": "aws_prod",
      "type": "cloud",
      "cloud": "aws",
      "region": "us-east-1",
      "name": "AWS Production",
      "deployment": "saas",
      "workloads": ["EC2", "S3", "RDS", "Lambda"],
      "vm_count": 200,
      "storage_tb": 80,
      "backup_software": "commvault",
      "backup_target": "none",
      "media_agents": 2,
      "retention_days": 30,
